# Optional settings for `docker compose up`. Copy to `.env` (git-ignored) and
# uncomment what you need; Docker Compose reads `.env` automatically. Shell
# environment variables work the same way. Never commit real values.

# Web port on the host (default 3000): http://localhost:3000
# PARALLAX_PORT=3000

# Claim a password for the seeded, passwordless `dev` account on first start.
# At least 8 characters. Remove it again after the first successful login.
# PARALLAX_CLAIM_USERNAME=dev
# PARALLAX_CLAIM_PASSWORD=

# Enables Alpha Vantage dataset imports. Left blank, imports are disabled.
# ALPHA_VANTAGE_API_KEY=

# Database password. Applied only when the database volume is first created.
# PARALLAX_DB_PASSWORD=

# PARALLAX_REGISTRATION_ENABLED=true
# PARALLAX_COOKIE_SECURE=false
